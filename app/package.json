{
  "name": "@slotlock/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p typecheck \"build-only {@}\" --",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write src/ e2e/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --build",
    "lint:check": "oxlint . && eslint . && prettier --check src/ e2e/",
    "api:generate": "openapi-typescript ../server/openapi.json -o src/api/schema.d.ts",
    "cert:dev": "node scripts/dev-certificate.ts",
    "icons": "node scripts/icons.ts"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@vueuse/core": "^15.0.0",
    "d3-hierarchy": "^3.1.2",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tsconfig/node26": "^26.0.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "acme-client": "^5.4.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.89.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "json5": "^2.2.3",
    "npm-run-all2": "^9.0.4",
    "openapi-typescript": "^7.13.0",
    "oxlint": "~1.89.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.0",
    "vite": "^8.3.5",
    "vite-plugin-json5": "^1.5.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
