upstream slotlock_app {
    server 127.0.0.1:3000;
    keepalive 16;
}

server {
    listen 443 ssl;
    http2 on;
    server_name slotlock.example.com;

    ssl_certificate     /etc/letsencrypt/live/slotlock.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/slotlock.example.com/privkey.pem;

    client_max_body_size 2m;

    location /socket.io/ {
        proxy_pass http://slotlock_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location ~ ^/api/rooms/[^/]+/seed$ {
        client_max_body_size 50m;
        proxy_pass http://slotlock_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10m;
    }

    location / {
        proxy_pass http://slotlock_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name slotlock.example.com;
    return 301 https://$host$request_uri;
}
