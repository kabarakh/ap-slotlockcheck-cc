{
  "name": "slotlock-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "app"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "run-p dev:server dev:app",
    "dev:server": "npm run start:dev -w server",
    "dev:app": "npm run dev -w app",
    "api:sync": "npm run openapi:export -w server && npm run api:generate -w app",
    "api:check": "npm run api:sync && git diff --exit-code -- server/openapi.json app/src/api/schema.d.ts",
    "build": "run-s api:sync build:app",
    "build:app": "npm run build -w app",
    "start": "npm run start:prod -w server",
    "lint": "npm run lint --workspaces",
    "lint:check": "npm run lint:check --workspaces",
    "format": "npm run format --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run test:e2e -w app",
    "outdated": "npm outdated --workspaces --include-workspace-root",
    "audit:check": "npm audit --omit=dev --audit-level=moderate --workspaces --include-workspace-root",
    "prepare": "husky",
    "prototype:report": "npm run prototype:report -w server --",
    "dev:public": "cross-env SLOTLOCK_PUBLIC_DEV_HOSTS=slotlock.example.com run-p dev:server dev:app",
    "cert:dev": "cross-env SLOTLOCK_PUBLIC_DEV_HOSTS=slotlock.example.com npm run cert:dev -w app"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "npm-run-all2": "^9.0.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "multer": "2.5.0",
    "openapi-typescript": {
      "typescript": "~6.0.3"
    }
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "prisma": true,
    "@prisma/engines": true,
    "better-sqlite3": true
  }
}
