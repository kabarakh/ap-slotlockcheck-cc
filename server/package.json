    "prototype:report": "node dist/prototype/prototype-report.main.js",
    "preprototype:report": "nest build",
    "seed:report": "node dist/seed/seed-report.main.js",
    "preseed:report": "nest build",
    "test:integration": "vp test run --config ./vitest.config.e2e.ts"
