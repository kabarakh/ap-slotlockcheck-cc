  "info": {
    "title": "Slotlock Tracker API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "avatar": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "number"
          },
          "discordId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "avatar",
          "id",
          "discordId",
          "name",
          "username"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "user": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthUserDto"
              }
            ]
          }
        },
        "required": [
          "user"
        ]
      },
      "SyncStatusDto": {
        "type": "object",
        "properties": {
          "lastSyncAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "lastSuccessfulSyncAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "lastSyncError": {
            "type": "string",
            "nullable": true
          },
          "running": {
            "type": "boolean"
          }
        },
        "required": [
          "lastSyncAt",
          "lastSuccessfulSyncAt",
          "lastSyncError",
          "running"
        ]
      },
      "RoomSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "slotCount": {
            "type": "number"
          },
          "lockedSlotCount": {
            "type": "number"
          },
          "unlockedSlotCount": {
            "type": "number"
          },
          "unlockedPercentage": {
            "type": "number"
          },
          "syncStatus": {
            "$ref": "#/components/schemas/SyncStatusDto"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "slotCount",
          "lockedSlotCount",
          "unlockedSlotCount",
          "unlockedPercentage",
          "syncStatus"
        ]
      },
      "RoomDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "slotCount": {
            "type": "number"
          },
          "lockedSlotCount": {
            "type": "number"
          },
          "unlockedSlotCount": {
            "type": "number"
          },
          "unlockedPercentage": {
            "type": "number"
          },
          "syncStatus": {
            "$ref": "#/components/schemas/SyncStatusDto"
          },
          "cheeseTrackerId": {
            "type": "string"
          },
          "cheeseTrackerUrl": {
            "type": "string"
          },
          "archipelagoTrackerUrl": {
            "type": "string"
          },
          "yellowLimitHours": {
            "type": "number"
          },
          "redLimitHours": {
            "type": "number"
          },
          "limitsOverridden": {
            "type": "boolean"
          },
          "unknownSlotNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manualSyncCooldownSeconds": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "slotCount",
          "lockedSlotCount",
          "unlockedSlotCount",
          "unlockedPercentage",
          "syncStatus",
          "cheeseTrackerId",
          "cheeseTrackerUrl",
          "archipelagoTrackerUrl",
          "yellowLimitHours",
          "redLimitHours",
          "limitsOverridden",
          "unknownSlotNames",
          "manualSyncCooldownSeconds"
        ]
      },
      "TrackerStatus": {
        "type": "string",
        "enum": [
          "disconnected",
          "connected",
          "ready",
          "playing",
          "goal_completed"
        ]
      },
      "ProgressionStatus": {
        "type": "string",
        "enum": [
          "unknown",
          "unblocked",
          "bk",
          "go",
          "soft_bk"
        ]
      },
      "CompletionStatus": {
        "type": "string",
        "enum": [
          "incomplete",
          "all_checks",
          "goal",
          "done",
          "released"
        ]
      },
      "AvailabilityStatus": {
        "type": "string",
        "enum": [
          "unknown",
          "open",
          "claimed",
          "public"
        ]
      },
      "LockStatus": {
        "type": "string",
        "enum": [
          "not_locked",
          "locked",
          "partially_unlocked",
          "unlocked"
        ]
      },
      "UnlockTimeSource": {
        "type": "string",
        "enum": [
          "sync",
          "estimated",
          "manual",
          "csv",
          "unknown"
        ]
      },
      "SlotLockDto": {
        "type": "object",
        "properties": {
          "senderSlotId": {
            "type": "number",
            "nullable": true
          },
          "senderName": {
            "type": "string",
            "nullable": true
          },
          "unlockTime": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "timeSource": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/UnlockTimeSource"
              }
            ]
          },
          "lockerSlotId": {
            "type": "number"
          },
          "lockerName": {
            "type": "string"
          },
          "unlocked": {
            "type": "boolean"
          }
        },
        "required": [
          "senderSlotId",
          "senderName",
          "unlockTime",
          "timeSource",
          "lockerSlotId",
          "lockerName",
          "unlocked"
        ]
      },
      "SlotRowDto": {
        "type": "object",
        "properties": {
          "discordUserId": {
            "type": "string",
            "nullable": true
          },
          "discordName": {
            "type": "string",
            "nullable": true
          },
          "lastActivity": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "trackerStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrackerStatus"
              }
            ]
          },
          "progressionStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProgressionStatus"
              }
            ]
          },
          "completionStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CompletionStatus"
              }
            ]
          },
          "availabilityStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AvailabilityStatus"
              }
            ]
          },
          "lockStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LockStatus"
              }
            ]
          },
          "locks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotLockDto"
            }
          },
          "unlockTime": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "unlockTimeSource": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/UnlockTimeSource"
              }
            ]
          },
          "id": {
            "type": "number"
          },
          "position": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "game": {
            "type": "string"
          },
          "checksDone": {
            "type": "number"
          },
          "checksTotal": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          },
          "isSlotLock": {
            "type": "boolean"
          },
          "isSelectedSlotLock": {
            "type": "boolean"
          },
          "warningCount": {
            "type": "number"
          }
        },
        "required": [
          "discordUserId",
          "discordName",
          "lastActivity",
          "trackerStatus",
          "progressionStatus",
          "completionStatus",
          "availabilityStatus",
          "lockStatus",
          "locks",
          "unlockTime",
          "unlockTimeSource",
          "id",
          "position",
          "name",
          "game",
          "checksDone",
          "checksTotal",
          "notes",
          "isSlotLock",
          "isSelectedSlotLock",
          "warningCount"
        ]
      },
      "RoomRole": {
        "type": "string",
        "enum": [
          "visitor",
          "player",
          "admin"
        ]
      },
      "RoomMembershipDto": {
        "type": "object",
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RoomRole"
              }
            ]
          },
          "isOwner": {
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "isOwner"
        ]
      },
      "RoomPreviewRequestDto": {
