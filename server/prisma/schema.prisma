generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          Int            @id @default(autoincrement())
  discordId   String         @unique
  name        String
  username    String         @default("")
  avatar      String?
  lastLoginAt DateTime?
  createdAt   DateTime       @default(now())
  roomAdmins  RoomAdmin[]
  warnings    Warning[]
  seedUploads SeedData[]
  fillerMarks SeedLocation[]
}

model Room {
  id                   Int               @id @default(autoincrement())
  slug                 String            @unique
  title                String
  cheeseTrackerId      String            @unique
  archipelagoOrigin    String
  archipelagoRoomId    String?
  archipelagoTrackerId String
  ownerCtUserId        Int?
  ownerDiscordName     String?
  yellowLimitHours     Int
  redLimitHours        Int
  limitsOverridden     Boolean           @default(false)
  createdAt            DateTime          @default(now())
  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  lastSyncError        String?
  unknownSlotNames     String            @default("[]")
  sphereOffset         Int               @default(0)
  visitorsSeeLocations Boolean           @default(false)
  playersMarkFiller    Boolean           @default(false)
  slots                Slot[]
  admins               RoomAdmin[]
  lockAssignments      LockAssignment[]
  unlockItems          UnlockItem[]
  warnings             Warning[]
  syncRuns             SyncRun[]
  snapshots            SyncSnapshot[]
  invitations          AdminInvitation[]
  seed                 SeedData?
  seedLocations        SeedLocation[]
}

model RoomAdmin {
  roomId  Int
  userId  Int
  isOwner Boolean @default(false)
  role    String  @default("admin")
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
}

model Slot {
  id                  Int              @id @default(autoincrement())
  roomId              Int
  cheeseGameId        Int
  position            Int
  name                String
  archipelagoName     String?
  archipelagoGoal     Boolean          @default(false)
  archipelagoActivity DateTime?
  game                String
  discordUserId       String?
  discordName         String?
  checksDone          Int
  checksTotal         Int
  lastActivity        DateTime?
  lastChecked         DateTime?
  trackerStatus       String
  progressionStatus   String
  completionStatus    String
  availabilityStatus  String
  notes               String
  isSlotLock          Boolean          @default(false)
  isSelectedSlotLock  Boolean          @default(false)
  isStartSlot         Boolean          @default(false)
  room                Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  locksAsLocker       LockAssignment[] @relation("LockerSlot")
  locksAsLocked       LockAssignment[] @relation("LockedSlot")
  unlocksAsLocker     UnlockItem[]     @relation("UnlockLocker")
  unlocksAsLocked     UnlockItem[]     @relation("UnlockLocked")
  unlocksAsSender     UnlockItem[]     @relation("UnlockSender")
  warnings            Warning[]
  foundLocations      SeedLocation[]   @relation("LocationFinder")
  receivedLocations   SeedLocation[]   @relation("LocationReceiver")

  @@unique([roomId, position])
}

model LockAssignment {
  id           Int     @id @default(autoincrement())
  roomId       Int
  lockerSlotId Int
  lockedSlotId Int
  source       String
  notLocked    Boolean @default(false)
  room         Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  lockerSlot   Slot    @relation("LockerSlot", fields: [lockerSlotId], references: [id], onDelete: Cascade)
  lockedSlot   Slot    @relation("LockedSlot", fields: [lockedSlotId], references: [id], onDelete: Cascade)

  @@unique([lockerSlotId, lockedSlotId])
}

model UnlockItem {
  id           Int       @id @default(autoincrement())
  roomId       Int
  lockerSlotId Int
  lockedSlotId Int
  senderSlotId Int?
  firstSeenAt  DateTime
  unlockTime   DateTime?
  timeSource   String
  room         Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  lockerSlot   Slot      @relation("UnlockLocker", fields: [lockerSlotId], references: [id], onDelete: Cascade)
  lockedSlot   Slot      @relation("UnlockLocked", fields: [lockedSlotId], references: [id], onDelete: Cascade)
  senderSlot   Slot?     @relation("UnlockSender", fields: [senderSlotId], references: [id], onDelete: SetNull)

  @@unique([lockerSlotId, lockedSlotId])
}

model Warning {
  id          Int      @id @default(autoincrement())
  roomId      Int
  slotId      Int
  adminUserId Int
  date        DateTime
  text        String
  createdAt   DateTime @default(now())
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  slot        Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  admin       User     @relation(fields: [adminUserId], references: [id])
}

model SyncRun {
  id         Int       @id @default(autoincrement())
  roomId     Int
  trigger    String
  startedAt  DateTime
  finishedAt DateTime?
  result     String
  error      String?
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model SyncSnapshot {
  id             Int      @id @default(autoincrement())
  roomId         Int
  source         String
  hash           String
  payload        String
  firstSyncRunId Int
  lastSyncRunId  Int
  createdAt      DateTime @default(now())
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, source])
}

model Datapackage {
  checksum      String   @id
  game          String
  itemNames     String
  locationNames String?
  createdAt     DateTime @default(now())
}

model AdminInvitation {
  id              Int       @id @default(autoincrement())
  roomId          Int
  tokenHash       String    @unique
  validUntil      DateTime
  createdByUserId Int
  usedByUserId    Int?
  usedAt          DateTime?
  role            String    @default("admin")
  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model SeedData {
  roomId                   Int      @id
  seedName                 String
  archipelagoVersion       String
  locationCount            Int
  sphereCount              Int
  unreachableLocationCount Int
  uploadedAt               DateTime @default(now())
  uploadedByUserId         Int
  room                     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  uploadedBy               User     @relation(fields: [uploadedByUserId], references: [id])
}

model SeedLocation {
  id                   Int       @id @default(autoincrement())
  roomId               Int
  finderSlotId         Int
  receiverSlotId       Int?
  receiverName         String
  locationId           BigInt
  locationName         String
  itemId               BigInt
  itemName             String
  itemType             String
  sphere               Int
  checked              Boolean   @default(false)
  checkedFirstSeenAt   DateTime?
  fillerMarkedAt       DateTime?
  fillerMarkedByUserId Int?
  room                 Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  finderSlot           Slot      @relation("LocationFinder", fields: [finderSlotId], references: [id], onDelete: Cascade)
  receiverSlot         Slot?     @relation("LocationReceiver", fields: [receiverSlotId], references: [id], onDelete: SetNull)
  fillerMarkedBy       User?     @relation(fields: [fillerMarkedByUserId], references: [id], onDelete: SetNull)

  @@unique([roomId, finderSlotId, locationId])
  @@index([roomId, sphere])
  @@index([roomId, checked, sphere])
  @@index([roomId, finderSlotId])
}
