NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://slotlock.example.com
ADDITIONAL_ORIGINS=
DATABASE_URL=file:/home/<USER>/slotlock/shared/data/slotlock.db
JWT_SECRET=<RANDOM_STRING_WITH_AT_LEAST_32_CHARACTERS>
DISCORD_CLIENT_ID=<DISCORD_CLIENT_ID>
DISCORD_CLIENT_SECRET=<DISCORD_CLIENT_SECRET>
DISCORD_CALLBACK_URL=https://slotlock.example.com/api/auth/discord/callback
CHEESE_BASE_URL=https://cheesetrackers.theincrediblewheelofchee.se
HTTP_USER_AGENT=SlotlockTracker/0.1.0 (+https://github.com/<OWNER>/<REPOSITORY>)
SYNC_INTERVAL_MINUTES=5
MANUAL_SYNC_COOLDOWN_SECONDS=60
HTTP_TIMEOUT_SECONDS=30
APP_DIST_PATH=/home/<USER>/slotlock/current/app/dist
TRUST_PROXY=true
CHECKPOINT_DISABLE=1
